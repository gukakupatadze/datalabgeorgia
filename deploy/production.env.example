# Docker images are added by the deployment workflow. Do not add IMAGE_TAG here.
# Use your domain for automatic HTTPS, for example: datalabgeorgia.ge
# Until DNS is ready, an explicit HTTP address can be used: http://203.0.113.10
SITE_ADDRESS=datalabgeorgia.ge
HTTP_PORT=80
HTTPS_PORT=443

# Internal MongoDB is not published to the internet.
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=tecservice_crm
USE_IN_MEMORY_DB=false

# Public URLs must match SITE_ADDRESS. The CRM is served under /admin.
CORS_ORIGINS=https://datalabgeorgia.ge
BACKEND_URL=https://datalabgeorgia.ge
FRONTEND_URL=https://datalabgeorgia.ge/admin
GOOGLE_REDIRECT_URI=https://datalabgeorgia.ge/api/auth/google/callback
COOKIE_SECURE=true
SESSION_HOURS=12

# Authentication. Keep all real values in the GitHub production environment secret.
AUTH_DISABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_ADMIN_EMAIL=gukakupatadze13@gmail.com
INITIAL_ADMIN_NAME=DataLab Administrator
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Public assistant. knowledge is free; openai needs OPENAI_API_KEY.
AI_PROVIDER=knowledge
AI_CHAT_PER_MINUTE=6
AI_CHAT_PER_DAY=30
AI_CHAT_IP_PER_MINUTE=20
AI_CHAT_IP_PER_DAY=200
AI_CHAT_GLOBAL_PER_DAY=1000
AI_PROVIDER_TIMEOUT=45
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODERATION_ENABLED=true

# Invoice issuer details (set real values only in PRODUCTION_ENV_FILE_B64).
INVOICE_SELLER_NAME=
INVOICE_SELLER_STATUS=მცირე მეწარმე
INVOICE_SELLER_ID=
INVOICE_SELLER_IBAN=
INVOICE_SELLER_BANK=თიბისი ბანკი
