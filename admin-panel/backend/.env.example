MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=tecservice_crm
CORS_ORIGINS=http://localhost:3000
# true რეჟიმში MongoDB არ არის საჭირო, მაგრამ მონაცემები გაჩერებისას იკარგება.
USE_IN_MEMORY_DB=false

# Google OpenID Connect authentication. Never commit real secrets.
AUTH_DISABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
INITIAL_ADMIN_EMAIL=gukakupatadze13@gmail.com
INITIAL_ADMIN_NAME=CRM Administrator
# პირველი ადმინისტრატორის ძლიერი პაროლი; რეალური მნიშვნელობა GitHub-ში არ ატვირთო.
INITIAL_ADMIN_PASSWORD=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_HOURS=12
# Use true only when the public CRM is served over HTTPS.
COOKIE_SECURE=false

# Public DataLab assistant. Default knowledge mode is free and uses no external API.
# For a local generative model: AI_PROVIDER=ollama and `ollama run qwen3:4b`.
# For OpenAI: AI_PROVIDER=openai and set OPENAI_API_KEY only on the backend server.
AI_PROVIDER=knowledge
AI_CHAT_PER_MINUTE=6
AI_CHAT_PER_DAY=30
AI_CHAT_IP_PER_MINUTE=20
AI_CHAT_IP_PER_DAY=200
AI_CHAT_GLOBAL_PER_DAY=1000
AI_PROVIDER_TIMEOUT=45
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODERATION_ENABLED=true

# Invoice issuer details (keep real ID and IBAN only in environment secrets).
INVOICE_SELLER_NAME=
INVOICE_SELLER_STATUS=მცირე მეწარმე
INVOICE_SELLER_ID=
INVOICE_SELLER_IBAN=
INVOICE_SELLER_BANK=თიბისი ბანკი
