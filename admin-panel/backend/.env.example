MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
DB_NAME=tecservice_crm
CORS_ORIGINS=http://localhost:3000
# true რეჟიმში MongoDB არ არის საჭირო, მაგრამ მონაცემები გაჩერებისას იკარგება.
USE_IN_MEMORY_DB=false

# Google OpenID Connect authentication. Never commit real secrets.
AUTH_DISABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
INITIAL_ADMIN_EMAIL=your-admin@gmail.com
INITIAL_ADMIN_NAME=CRM Administrator
# პირველი ადმინისტრატორის ძლიერი პაროლი; რეალური მნიშვნელობა GitHub-ში არ ატვირთო.
INITIAL_ADMIN_PASSWORD=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SESSION_HOURS=12
# Use true only when the public CRM is served over HTTPS.
COOKIE_SECURE=false
